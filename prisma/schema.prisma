generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model ApiLog {
  id Int @id @default(autoincrement())
  url String
  fromCache Boolean @default(false)
  status String
  durationMs Int?
  createdAt DateTime @default(now())
}

model WebhookEvent {
  id Int @id @default(autoincrement())
  eventId String @unique
  type String?
  payload Json?
  status String
  createdAt DateTime @default(now())
}